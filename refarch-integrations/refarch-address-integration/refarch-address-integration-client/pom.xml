<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.muenchen.oss.refarch</groupId>
        <artifactId>refarch-address-integration</artifactId>
        <version>4.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>refarch-address-integration-client</artifactId>
    <name>refarch-address-integration-client</name>

    <properties>
        <openapi-generator-maven-plugin.version>7.25.0</openapi-generator-maven-plugin.version>

        <jackson-databind-nullable.version>0.2.12</jackson-databind-nullable.version>
    </properties>

    <dependencies>
        <!-- Spring -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-logging</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webflux</artifactId>
        </dependency>

        <!-- openApi -->
        <dependency>
            <groupId>org.openapitools</groupId>
            <artifactId>jackson-databind-nullable</artifactId>
            <version>${jackson-databind-nullable.version}</version>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>address-integration</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/apidoc/api-docs.json</inputSpec>

                            <generatorName>java</generatorName>
                            <library>webclient</library>

                            <apiPackage>de.muenchen.oss.refarch.integration.address.client.gen.api</apiPackage>
                            <modelPackage>de.muenchen.oss.refarch.integration.address.client.gen.model</modelPackage>
                            <invokerPackage>de.muenchen.oss.refarch.integration.address.client.gen</invokerPackage>

                            <typeMappings>
                                <typeMapping>DateTime=String</typeMapping>
                                <typeMapping>Date=String</typeMapping>
                            </typeMappings>

                            <configOptions>
                                <dateLibrary>Java8</dateLibrary>
                                <useJakartaEe>true</useJakartaEe>
                                <useSpringBoot4>true</useSpringBoot4>
                                <useJackson3>true</useJackson3>
                                <performBeanValidation>true</performBeanValidation>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
