        <xs:sequence>
            <xs:element name="filename" type="xs:string"/>
            <xs:element name="satzart010" type="tns:Satzart010Type"/>
            <xs:element name="satzart100" type="tns:Satzart100Type" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="satzart105" type="tns:Satzart105Type" minOccurs="0" maxOccurs="unbounded"/>
