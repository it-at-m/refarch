            <xs:element name="satzartFehler" type="tns:SatzartFehlerType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Global element used as the SOAP message part and the REST/JSON root. -->
    <xs:element name="pscdBatch" type="tns:PscdBatch"/>

