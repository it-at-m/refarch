<?xml version="1.0" encoding="UTF-8"?>
<!--
  refarch-owned canonical schema for an inbound PSCD "Satzarten" batch.

  This is the single source of truth for the module's inbound contract. It is intentionally NOT the
  vendor (SAP PI) DT_SOAPSatzarten schema: element names are the module's own idiomatic camelCase,
  mirroring the domain aggregate 1:1, so the generated model produces clean JSON for REST and a
  near-trivial mapping to the domain. The same generated types back both the SOAP endpoint (via the
  importing WSDL) and the REST endpoint (as JSON).

  Constraints kept deliberately simple so the generated types round-trip cleanly as JSON:
  only plain nullable xsd:string elements, no nillable="true", no element refs (either would make
  XJC emit JAXBElement<T> wrappers).
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="https://refarch.muenchen.de/pscd/inbound/v1"
           targetNamespace="https://refarch.muenchen.de/pscd/inbound/v1"
           elementFormDefault="qualified"
           version="1.0">

    <!-- ==== Batch aggregate ==== -->
